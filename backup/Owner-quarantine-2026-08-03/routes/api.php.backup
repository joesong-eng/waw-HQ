Route::prefix('internal/kiosk')->middleware('verify.internal.key')->group(function () {
    Route::post('/event', [InternalKioskController::class, 'handleEvent']);
    Route::post('/callback', [InternalKioskController::class, 'handleCallback']);
});

// iHub Integration API
Route::prefix('v1')->middleware('verify.ihub.token')->group(function () {
    Route::post('/audit/report', [IhubIntegrationController::class, 'auditReport']);
    Route::post('/event/pulse', [IhubIntegrationController::class, 'eventPulse']);
});

