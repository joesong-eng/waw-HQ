    Route::prefix('v9/radar')->group(function () {
        Route::get('/devices', [RealtimeController::class, 'getRadarDevices']);
    });
});

Route::middleware(['web', 'auth'])->prefix('v9/realtime')->group(function () {
    Route::get('/devices', [RealtimeController::class, 'getDevices']);
    Route::get('/devices/{chipId}/commands', [RealtimeController::class, 'getCommandHistory']);
});

