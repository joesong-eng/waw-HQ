    Route::post('/device-update', [InternalBroadcastController::class, 'deviceUpdate']);
});

Route::prefix('internal/devices')->middleware('verify.internal.key')->group(function () {
    Route::post('/register', [InternalDeviceController::class, 'register']);
});

