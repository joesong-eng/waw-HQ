use App\Http\Controllers\Api\V9\DeviceController;
use App\Http\Controllers\Api\V9\DeviceRegistrationController;
use App\Http\Controllers\Api\V9\ParameterTemplateController;
use App\Http\Controllers\Api\V9\RevenueController;
use App\Http\Controllers\Api\V9\ValidationController;
use App\Http\Controllers\Api\V9\VenueController;
use App\Http\Controllers\Api\V9\VenueStaffController;
use App\Http\Controllers\Api\V9\ProfitSharingController;
use App\Http\Controllers\Api\V9\DeviceTypeController;
use App\Http\Controllers\Api\V9\NotificationController;
use App\Http\Controllers\Api\V9\OtaController;
use App\Http\Controllers\Api\V9\LineBindingController;
use App\Http\Controllers\Api\V9\SettlementController;
