// M7 Settlement System - 每月 1 號 00:00 UTC 生成上月結算單
Schedule::job(new \App\Jobs\GenerateMonthlySettlements)
    ->monthlyOn(1, '00:00')
    ->timezone('UTC')
    ->withoutOverlapping()
    ->onOneServer();

// 【TEMP DISABLED 2026-06-16】暫停，查詢不存在的 owner_subscriptions.end_date
// Schedule::command('subscription:check-expiry')
//     ->dailyAt('00:00')
//     ->timezone('Asia/Taipei');

// M8 Billing & Renewal - 每日 09:00 發送續費提醒
Schedule::command('subscription:send-reminders')
    ->dailyAt('09:00')
    ->timezone('Asia/Taipei');

// WAW 2.0 PHASE3 - 每日 10:00 發送欠費催收通知
Schedule::command('arrears:notify')
    ->dailyAt('10:00')
    ->timezone('Asia/Taipei')
    ->withoutOverlapping()
    ->onOneServer();

// 深夜自動對帳 - 每日 02:00 執行（T+1，確保當日資料完整）
Schedule::command('v9:reconcile:nightly')
    ->dailyAt('02:00')
    ->timezone('Asia/Taipei')
    ->withoutOverlapping()
    ->onOneServer();
